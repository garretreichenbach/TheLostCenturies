# Copy to .env (next to compose.yml) and fill in.

# Tailscale IPv4 of the SOE box:  tailscale ip -4
TS_IP=100.x.y.z
# Name you'll type in the browser. The Tailscale IP always works; a MagicDNS name
# (soe.<tailnet>.ts.net) is nicer if the box resolves MagicDNS.
PANEL_HOST=100.x.y.z
PANEL_PORT=8090

# Used by the panel for mail / Let's Encrypt (LE is skipped in this setup, but the variable is required).
ADMIN_EMAIL=you@example.com

# Panel's Docker network. Change both if preflight.sh shows 172.20.x in use.
PANEL_SUBNET=172.20.0.0/16
PANEL_GATEWAY=172.20.0.1
